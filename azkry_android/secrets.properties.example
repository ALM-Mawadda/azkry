# Copy to secrets.properties (git-ignored) and fill in before building a release.
# Release packaging FAILS without these — it never falls back to debug signing.
#
# Create the keystore first (choose your own passwords; keep them in a password
# manager, and back the .jks file up somewhere you will still have in 5 years):
#
#   keytool -genkeypair -v \
#     -keystore azkry-release.jks \
#     -alias azkry \
#     -keyalg RSA -keysize 4096 -validity 10000
#
# RELEASE_KEYSTORE_PATH is resolved relative to the azkry_android/ directory.
# Keep the .jks OUTSIDE the repo, or rely on the *.jks gitignore rule.

RELEASE_KEYSTORE_PATH=azkry-release.jks
RELEASE_KEYSTORE_PASSWORD=
RELEASE_KEY_ALIAS=azkry
RELEASE_KEY_PASSWORD=
